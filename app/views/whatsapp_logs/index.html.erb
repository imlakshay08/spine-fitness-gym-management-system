<div class="page-wrapper">
<%= render "layouts/header" %>
<!-- start page container -->
  <div class="page-container">
    <%= render "layouts/sidebar" %>
    <div class="page-content-wrapper">
      <div class="page-content wa-logs">

        <div class="page-bar">
          <div class="page-title-breadcrumb">
            <div class="pull-left">
              <div class="page-title">WhatsApp Message Logs</div>
            </div>
            <%= render "layouts/breadcrumbs" %>
          </div>
        </div>

        <%# ---------- Summary cards ---------- %>
        <div class="row wa-stats">
          <div class="col-md col-sm-6">
            <div class="wa-stat-card wa-stat-total">
              <div class="wa-stat-icon"><i class="fa-brands fa-whatsapp"></i></div>
              <div class="wa-stat-body">
                <div class="wa-stat-value"><%= @stats[:total] %></div>
                <div class="wa-stat-label">Total Sent</div>
              </div>
            </div>
          </div>
          <div class="col-md col-sm-6">
            <div class="wa-stat-card wa-stat-delivered">
              <div class="wa-stat-icon"><i class="fa-solid fa-check-double"></i></div>
              <div class="wa-stat-body">
                <div class="wa-stat-value"><%= @stats[:delivered] %></div>
                <div class="wa-stat-label">Delivered</div>
              </div>
            </div>
          </div>
          <div class="col-md col-sm-6">
            <div class="wa-stat-card wa-stat-read">
              <div class="wa-stat-icon"><i class="fa-solid fa-check-double"></i></div>
              <div class="wa-stat-body">
                <div class="wa-stat-value"><%= @stats[:read] %> <small><%= @stats[:read_rate] %>%</small></div>
                <div class="wa-stat-label">Read</div>
              </div>
            </div>
          </div>
          <div class="col-md col-sm-6">
            <div class="wa-stat-card wa-stat-pending">
              <div class="wa-stat-icon"><i class="fa-solid fa-paper-plane"></i></div>
              <div class="wa-stat-body">
                <div class="wa-stat-value"><%= @stats[:pending] %></div>
                <div class="wa-stat-label">In Transit</div>
              </div>
            </div>
          </div>
          <div class="col-md col-sm-6">
            <div class="wa-stat-card wa-stat-failed">
              <div class="wa-stat-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
              <div class="wa-stat-body">
                <div class="wa-stat-value"><%= @stats[:failed] %></div>
                <div class="wa-stat-label">Failed</div>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-12">
            <div class="card">
              <div class="card-body">

                <%# ---------- Filters ---------- %>
                <%= form_tag({ action: 'index' }, multipart: true, id: 'myForms') do %>
                  <input type="hidden" id="rootXPath" value="<%= root_url %>"/>
                  <input type="hidden" name="server_request" id="server_request" value="Y"/>

                  <div class="row m-b-10 align-items-center">
                    <div class="col-sm-12 col-md-3 d-flex align-items-center gap-2">
                      <label class="mb-0">Message</label>
                      <select class="form-select select-height" name="template_filter" id="template_filter">
                        <option value="">All Types</option>
                        <% @templates.each do |name, meta| %>
                          <option value="<%= name %>" <%= 'selected' if @template_filter == name %>><%= meta[:label] %></option>
                        <% end %>
                      </select>
                    </div>

                    <div class="col-sm-12 col-md-2 d-flex align-items-center gap-2">
                      <label class="mb-0">Status</label>
                      <select class="form-select select-height" name="status_filter" id="status_filter">
                        <% [['', 'All'], ['READ', 'Read'], ['DELIVERED', 'Delivered'], ['SENT', 'Sent'], ['QUEUED', 'Queued'], ['FAILED', 'Failed']].each do |val, lbl| %>
                          <option value="<%= val %>" <%= 'selected' if @status_filter == val %>><%= lbl %></option>
                        <% end %>
                      </select>
                    </div>

                    <div class="col-sm-12 col-md-3">
                      <input type="text" class="form-control" name="log_search" id="log_search"
                             placeholder="Search member name / phone / code"
                             value="<%= @search %>"/>
                    </div>

                    <div class="col-sm-12 col-md-1 no_loader">
                      <button type="button" onclick="filter_whatsapp_logs();" class="btn btn-circle btn-default">
                        <i class="fa fa-search"></i>
                      </button>
                    </div>

                    <div class="col-sm-12 col-md-1 show_loader hidden">
                      <div class="mdl-spinner mdl-spinner--single-color mdl-js-spinner">
                        <img src="<%= root_url %>/images/spining_loader.gif" width="30px">
                      </div>
                    </div>

                    <div class="col-sm-12 col-md-2 text-right">
                      <a href="<%= root_url %>whatsapp_logs/refresh">
                        <button type="button" class="btn btn-circle btn-info">
                          <i class="fa fa-refresh"></i> Reset
                        </button>
                      </a>
                    </div>
                  </div>
                <% end %>

                <%# ---------- Table ---------- %>
                <div class="table-responsive">
                  <table class="table table-striped table-hover wa-table" id="whatsapp_logs_table" style="width:100%">
                    <thead>
                      <tr>
                        <th>#</th>
                        <th>Member</th>
                        <th>Message</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Sent</th>
                        <th>Delivered</th>
                        <th>Read</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if @logs.present? %>
                        <% @logs.each_with_index do |log, idx| %>
                          <%
                            member  = @members_hash[log.wl_member_id.to_s]
                            orphan  = member.nil?
                            name    = member&.mmbr_name.presence || "Deleted member"
                            contact = member&.mmbr_contact
                            code    = member&.mmbr_code
                            message = wa_message_body(log, @subs_hash)
                            info    = wa_status_info(log.wl_status)
                          %>
                          <tr class="<%= 'wa-row-orphan' if orphan %>">
                            <td><%= idx + 1 %></td>

                            <td class="wa-member-cell">
                              <div class="wa-avatar"><%= name[0].to_s.upcase %></div>
                              <div class="wa-member-meta">
                                <div class="wa-member-name"><%= name %></div>
                                <div class="wa-member-sub">
                                  <% if code.present? %><span class="wa-code"><%= code %></span><% end %>
                                  <% if contact.present? %><span class="wa-phone"><i class="fa fa-phone"></i> <%= contact %></span><% end %>
                                </div>
                              </div>
                            </td>

                            <td class="wa-msg-cell">
                              <div class="wa-msg-preview" title="<%= message %>"><%= truncate(message, length: 90) %></div>
                            </td>

                            <td>
                              <span class="wa-type-badge wa-tone-<%= WhatsappTemplates.tone(log.wl_template_name) %>">
                                <i class="<%= WhatsappTemplates.icon(log.wl_template_name) %>"></i>
                                <%= WhatsappTemplates.label(log.wl_template_name) %>
                              </span>
                            </td>

                            <td><%= wa_status_badge(log.wl_status) %></td>

                            <td class="wa-time-cell"><%= wa_time(log.wl_sent_at) %></td>
                            <td class="wa-time-cell"><%= wa_time(log.wl_delivered_at) %></td>
                            <td class="wa-time-cell"><%= wa_time(log.wl_read_at) %></td>

                            <td class="text-center">
                              <button type="button" class="btn btn-sm btn-circle btn-success wa-view-btn"
                                      data-target-detail="wa-detail-<%= log.id %>">
                                <i class="fa fa-eye"></i>
                              </button>
                            </td>
                          </tr>
                        <% end %>
                      <% else %>
                        <tr>
                          <td colspan="9">
                            <div class="wa-empty-state">
                              <i class="fa-regular fa-comment-dots"></i>
                              <p>No messages match this view</p>
                              <span>Try clearing the filters, or check back after the next automated send.</span>
                            </div>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>

                <%# Hidden detail blocks — kept OUTSIDE the table (a <div> inside
                    <tbody> is invalid HTML and gets ejected by the browser).
                    Each is cloned into the modal when its row's eye icon is clicked. %>
                <div class="wa-details-store" style="display:none;">
                  <% if @logs.present? %>
                    <% @logs.each do |log| %>
                      <%
                        member  = @members_hash[log.wl_member_id.to_s]
                        name    = member&.mmbr_name.presence || "Deleted member"
                        contact = member&.mmbr_contact
                        code    = member&.mmbr_code
                        message = wa_message_body(log, @subs_hash)
                      %>
                      <div id="wa-detail-<%= log.id %>">
                        <div class="wa-detail-head">
                          <div class="wa-avatar wa-avatar-lg"><%= name[0].to_s.upcase %></div>
                          <div>
                            <div class="wa-member-name"><%= name %></div>
                            <div class="wa-member-sub">
                              <% if code.present? %><span class="wa-code"><%= code %></span><% end %>
                              <% if contact.present? %><span class="wa-phone"><i class="fa fa-phone"></i> <%= contact %></span><% end %>
                            </div>
                          </div>
                        </div>

                        <div class="wa-chat">
                          <div class="wa-bubble">
                            <div class="wa-bubble-text"><%= simple_format(message) %></div>
                            <div class="wa-bubble-meta">
                              <span><%= wa_ist(log.wl_sent_at)&.strftime("%I:%M %p") %></span>
                              <%= wa_ticks_html(log.wl_status) %>
                            </div>
                          </div>
                        </div>

                        <div class="wa-timeline">
                          <div class="wa-timeline-item done">
                            <span class="wa-dot"></span>
                            <span class="wa-tl-label">Sent</span>
                            <span class="wa-tl-time"><%= log.wl_sent_at ? wa_ist(log.wl_sent_at).strftime("%d %b %Y, %I:%M %p") : "—" %></span>
                          </div>
                          <div class="wa-timeline-item <%= 'done' if log.wl_delivered_at.present? %>">
                            <span class="wa-dot"></span>
                            <span class="wa-tl-label">Delivered</span>
                            <span class="wa-tl-time"><%= log.wl_delivered_at ? wa_ist(log.wl_delivered_at).strftime("%d %b %Y, %I:%M %p") : "Not yet delivered" %></span>
                          </div>
                          <div class="wa-timeline-item <%= 'done blue' if log.wl_read_at.present? %>">
                            <span class="wa-dot"></span>
                            <span class="wa-tl-label">Read</span>
                            <span class="wa-tl-time"><%= log.wl_read_at ? wa_ist(log.wl_read_at).strftime("%d %b %Y, %I:%M %p") : "Not read yet" %></span>
                          </div>
                          <% if log.wl_status.to_s.upcase == 'FAILED' %>
                            <div class="wa-timeline-item failed done">
                              <span class="wa-dot"></span>
                              <span class="wa-tl-label">Failed</span>
                              <span class="wa-tl-time"><%= log.wl_failed_reason.presence || "Unknown reason" %></span>
                            </div>
                          <% end %>
                        </div>

                        <div class="wa-raw">
                          <a class="wa-raw-toggle" data-bs-toggle="collapse" href="#wa-raw-<%= log.id %>">
                            <i class="fa fa-code"></i> Technical details
                          </a>
                          <div class="collapse" id="wa-raw-<%= log.id %>">
                            <table class="wa-raw-table">
                              <tr><td>Template</td><td><%= log.wl_template_name %></td></tr>
                              <tr><td>Message ID</td><td class="wa-mono"><%= log.wl_interakt_msg_id.presence || "—" %></td></tr>
                              <tr><td>Status</td><td><%= log.wl_status %></td></tr>
                            </table>
                            <% if log.wl_api_response.present? %>
                              <pre class="wa-api-response"><%= log.wl_api_response %></pre>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
                </div>

              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
<!-- End page container -->
</div>

<%# ---------- Detail modal ---------- %>
<div class="modal fade wa-modal" id="waDetailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header wa-modal-header">
        <h5 class="modal-title"><i class="fa-brands fa-whatsapp"></i> Message Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="waModalBody"></div>
    </div>
  </div>
</div>

