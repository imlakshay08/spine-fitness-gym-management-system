<div class="page-wrapper">
<%= render "layouts/header" %>
<div class="page-container">
<%= render "layouts/sidebar" %>
<div class="page-content-wrapper">
<div class="page-content">

<div class="page-bar">
  <div class="page-title-breadcrumb">
    <div class="pull-left">
      <div class="page-title">Member Profile</div>
    </div>
    <%= render "layouts/breadcrumbs" %>
  </div>
</div>

<%
  # Figure out current subscription status once, use everywhere
  is_active   = @latest_sub && @latest_sub.ms_end_date >= Date.today
  days_left   = @latest_sub ? (@latest_sub.ms_end_date - Date.today).to_i : nil
  latest_plan = @latest_sub ? @plans_hash[@latest_sub.ms_plan_id.to_i] : nil
  amount_paid = @latest_sub ? @payments_hash[@latest_sub.id.to_i].to_f : 0
%>

<!-- TOP ACTION BAR -->
<div class="row" style="margin-bottom: 16px;">
  <div class="col-md-6">
    <a href="<%= root_url %>member_list">
      <button type="button" class="btn btn-circle btn-info">
        <i class="fa fa-arrow-left"></i> Back to list
      </button>
    </a>
  </div>
  <div class="col-md-6 text-right">
    <a href="<%= root_url %>member_list/add_member/<%= @member.id %>">
      <button type="button" class="btn btn-circle btn-default">
        <i class="fa fa-pencil"></i> Edit member
      </button>
    </a>
    &nbsp;
    <a href="<%= root_url %>member_subscriptions/add_member_subscriptions?renew=1&member_id=<%= @member.id %>&from=member_list">
      <button type="button" class="btn btn-circle btn-success">
        <i class="fa fa-plus"></i> Add subscription
      </button>
    </a>
  </div>
</div>

<!-- MEMBER INFO CARD -->
<div class="row">
  <div class="col-md-12">
    <div class="card card-box">
      <div class="card-body">
        <div class="row">

          <!-- Avatar + Name -->
          <div class="col-md-1" style="display:flex; align-items:center; justify-content:center;">
            <div style="width:56px; height:56px; border-radius:50%;
                        background:#f0f0f0; display:flex; align-items:center;
                        justify-content:center; font-size:20px; font-weight:600;
                        color:#555; border:1px solid #ddd;">
              <%= @member.mmbr_name.to_s[0].upcase %>
            </div>
          </div>

          <!-- Name, code, contact in one line -->
          <div class="col-md-5" style="display:flex; flex-direction:column; justify-content:center;">
            <h4 style="margin:0 0 4px;">
              <%= @member.mmbr_name %>
            </h4>
            <div style="color:#888; font-size:13px;">
              <%= @member.mmbr_code %>
              &nbsp;·&nbsp;
              <%= @member.mmbr_gender == 'M' ? 'Male' : @member.mmbr_gender == 'F' ? 'Female' : 'Other' %>
              &nbsp;·&nbsp;
              <i class="fa fa-phone"></i> <%= @member.mmbr_contact %>
              <% if @member.mmbr_email.present? %>
                &nbsp;·&nbsp;
                <i class="fa fa-envelope"></i> <%= @member.mmbr_email %>
              <% end %>
            </div>
          </div>

          <!-- Quick stat: attendance -->
          <div class="col-md-2 text-center" style="border-left:1px solid #eee;">
            <div style="font-size:26px; font-weight:600; color:#555;">
              <%= @attendance_today %>
            </div>
            <div style="font-size:12px; color:#aaa;">Visits today</div>
          </div>

          <div class="col-md-2 text-center" style="border-left:1px solid #eee;">
            <div style="font-size:26px; font-weight:600; color:#555;">
              <%= @attendance_total %>
            </div>
            <div style="font-size:12px; color:#aaa;">Total visits</div>
          </div>

          <!-- Fingerprint status -->
          <div class="col-md-2 text-center" style="border-left:1px solid #eee;">
            <% if @biometric %>
              <div style="font-size:20px; color:#26a69a;">
                <i class="fa fa-check-circle"></i>
              </div>
              <div style="font-size:12px; color:#aaa;">Biometric enrolled</div>
            <% else %>
              <div style="font-size:20px; color:#aaa;">
                <i class="fa fa-times-circle"></i>
              </div>
              <div style="font-size:12px; color:#aaa;">No biometric</div>
            <% end %>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- CURRENT SUBSCRIPTION STATUS BANNER -->
<div class="row" style="margin-top: 16px;">
  <div class="col-md-12">

    <% if @latest_sub.nil? %>
      <!-- No subscription at all -->
      <div class="alert alert-warning" style="display:flex; align-items:center; justify-content:space-between;">
        <div>
          <strong>No subscription found</strong>
          &nbsp; — This member has never been subscribed.
        </div>
        <a href="<%= root_url %>member_subscriptions/add_member_subscriptions?member_id=<%= @member.id %>">
          <button class="btn btn-warning btn-sm">
            <i class="fa fa-plus"></i> Add first subscription
          </button>
        </a>
      </div>

    <% elsif is_active %>
      <!-- Active subscription -->
      <div class="alert alert-success" style="display:flex; align-items:center; justify-content:space-between;">
        <div>
          <strong>Active</strong>
          &nbsp;—&nbsp;
          <strong><%= latest_plan&.plan_name %></strong>
          &nbsp; plan &nbsp;·&nbsp;
          Paid <strong>₹<%= number_with_delimiter(amount_paid.to_i) %></strong>
          <% if @latest_sub.ms_payment_mode.present? %>
            via <%= @latest_sub.ms_payment_mode.upcase %>
          <% end %>
          &nbsp;·&nbsp;
          Valid till <strong><%= formatted_date(@latest_sub.ms_end_date) %></strong>
          &nbsp;·&nbsp;
          <% if days_left <= 7 %>
            <span style="color:#e53935; font-weight:600;"><%= days_left %> day<%= days_left == 1 ? '' : 's' %> left — renew soon</span>
          <% elsif days_left <= 30 %>
            <span style="color:#f57c00; font-weight:600;"><%= days_left %> days left</span>
          <% else %>
            <span style="color:#388e3c;"><%= days_left %> days left</span>
          <% end %>
        </div>
        <% if days_left <= 30 %>
          <a href="<%= root_url %>member_subscriptions/add_member_subscriptions?renew=1&member_id=<%= @member.id %>&from=member_list">
            <button class="btn btn-warning btn-sm">
              <i class="fa fa-refresh"></i> Renew
            </button>
          </a>
        <% end %>
      </div>

    <% else %>
      <!-- Expired -->
      <div class="alert alert-danger" style="display:flex; align-items:center; justify-content:space-between;">
        <div>
          <strong>Expired</strong>
          &nbsp;—&nbsp;
          Last plan was <strong><%= latest_plan&.plan_name %></strong>
          &nbsp;·&nbsp;
          Expired on <strong><%= formatted_date(@latest_sub.ms_end_date) %></strong>
          &nbsp;·&nbsp;
          Last paid <strong>₹<%= number_with_delimiter(amount_paid.to_i) %></strong>
        </div>
        <a href="<%= root_url %>member_subscriptions/add_member_subscriptions?renew=1&member_id=<%= @member.id %>&from=member_list">
          <button class="btn btn-danger btn-sm">
            <i class="fa fa-refresh"></i> Renew now
          </button>
        </a>
      </div>
    <% end %>

  </div>
</div>

<!-- SUBSCRIPTION HISTORY TABLE -->
<div class="row" style="margin-top: 8px;">
  <div class="col-md-12">
    <div class="card card-box">
      <div class="card-head">
        <header>Subscription history</header>
      </div>
      <div class="card-body">

        <% if @subscriptions.empty? %>
          <p style="color:#aaa; text-align:center; padding:20px;">No subscriptions found.</p>
        <% else %>

          <table class="table table-striped table-bordered table-hover">
            <thead>
              <tr>
                <th>Sub no.</th>
                <th>Plan</th>
                <th>Start date</th>
                <th>End date</th>
                <th>Plan amount</th>
                <th>Discount</th>
                <th>Amount paid</th>
                <th>Mode</th>
                <th>Days left</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @subscriptions.each do |sub| %>
                <%
                  sub_plan     = @plans_hash[sub.ms_plan_id.to_i]
                  sub_paid     = @payments_hash[sub.id.to_i].to_f
                  sub_status   = sub.ms_end_date >= Date.today ? 'ACTIVE' : 'EXPIRED'
                  sub_days     = (sub.ms_end_date - Date.today).to_i
                %>
                <tr>
                  <td><strong><%= sub.ms_sbscrptn_no %></strong></td>
                  <td><%= sub_plan&.plan_name || '—' %></td>
                  <td><%= formatted_date(sub.ms_start_date) %></td>
                  <td><%= formatted_date(sub.ms_end_date) %></td>
                  <td>₹<%= number_with_delimiter(sub.ms_plan_amount.to_i) %></td>
                  <td>
                    <% if sub.ms_discount_amount.to_f > 0 %>
                      <span style="color:#e53935;">
                        -₹<%= number_with_delimiter(sub.ms_discount_amount.to_i) %>
                      </span>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td>
                    <strong style="color:#26a69a;">
                      ₹<%= number_with_delimiter(sub_paid.to_i) %>
                    </strong>
                  </td>
                  <td>
                    <% if sub.ms_payment_mode.present? %>
                      <span class="badge <%= sub.ms_payment_mode.downcase == 'cash' ? 'badge-success' : 'badge-info' %>">
                        <%= sub.ms_payment_mode.upcase %>
                      </span>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td>
                    <% if sub_status == 'EXPIRED' %>
                      <span class="badge badge-danger">Expired</span>
                    <% elsif sub_days <= 7 %>
                      <span class="badge badge-danger"><%= sub_days %>d</span>
                    <% elsif sub_days <= 30 %>
                      <span class="badge badge-warning"><%= sub_days %>d</span>
                    <% else %>
                      <span class="badge badge-success"><%= sub_days %>d</span>
                    <% end %>
                  </td>
                  <td>
                    <% if sub_status == 'ACTIVE' %>
                      <span class="badge badge-success">Active</span>
                    <% else %>
                      <span class="badge badge-danger">Expired</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

        <% end %>

      </div>
    </div>
  </div>
</div>

</div>
</div>
</div>
</div>