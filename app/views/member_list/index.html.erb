<div class="page-wrapper">
<%= render "layouts/header" %>
<!-- start page container -->
		<div class="page-container">
		<%= render "layouts/sidebar" %>
 <div class="page-content-wrapper">
    <div class="page-content" >
           
    <div class="page-bar">
						<div class="page-title-breadcrumb">
							<div class=" pull-left">
								<div class="page-title">Members List</div>
							</div>
							<%= render "layouts/breadcrumbs" %>
						</div>
            
					</div>
          <div class="row">
          <div class="col-md-12">
            <div class="tabbable-line">
              <ul class="nav customtab nav-tabs" role="tablist">
                <li class="nav-item"><a href="#tab1" class="nav-link active"
                    data-bs-toggle="tab">List
                    View</a></li>
              </ul>
              <div class="tab-content">
									<div class="tab-pane active fontawesome-demo" id="tab1">
					<div class="row">
						<div class="col-md-12">
							<div class="row">
								<div class="col-sm-12">
									<div class="card">
								
										<div class="card-body ">
                    <% if flash[:error] %>
                    <div class="alert <% if session[:isErrorhandled].to_i >0 %>alert-danger<% else %>alert-success<% end %>" style="width:900px;" id="successXMessage">
                      <span class="closebtn" onclick="this.parentElement.style.display='none';">&times;</span>
                      <%= flash[:error] %>
                    </div>
                   <% end %>

          <%= form_tag({:action=>'index'}, :multipart=>true, id: 'myForms') do %>
          <input type="hidden" id="rootXPath" value="<%=root_url%>"/>
          <input type="hidden" name="server_request" id="server_request" value="Y"/>

            <div class="row m-b-10 align-items-center">
              <div class="col-sm-12 col-md-12 d-flex justify-content-end align-items-center gap-2">
                <a href="<%=root_url%>member_list/add_member">
                  <button type="button" class="btn btn-circle btn-success">
                    <i class="fa fa-plus"></i> Add Member
                  </button>
                </a>
              </div>
            </div>
          <% end %>
										<div class="table-loading-wrapper" id="member-table-wrapper">
                  <div class="table-loader-overlay" id="member-table-loader">
                    <div class="table-loader-spinner"></div>
                    <div class="table-loader-text">Loading members...</div>
                  </div>
                      <table
                      class="table table-striped table-bordered table-hover "
                      id="example4" >
                      <thead>
                        <tr>
                          <th>S.No</th>
                          <th>Member Code</th>
                          <th>Member Name</th>
                          <th>Gender</th>
                          <th>Contact No.</th>
                          <th>Plan</th>
                          <th>Amount Paid</th>
                          <th>Valid Till</th>
                          <th>Status</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody>
                      <% 
                       pagestart = params[:page].present? ? params[:page].to_i : 1
                         i = pagestart <= 1 ? 1 : ((pagestart - 1) * 10) + 1
                      if @member_list && @member_list.length>0 
                             @member_list.each do |member| %> 
                              <%
                                latest  = @latest_subscription_hash[member.id]
                                plan    = latest ? @plans_hash[latest.ms_plan_id.to_i] : nil
                                is_active = latest && latest.ms_end_date >= Date.today
                                days_left = latest ? (latest.ms_end_date - Date.today).to_i : nil
                              %>
                              <tr class="odd gradeX">
                                <td><%= i %></td>
                                <td><%= member.mmbr_code %></td>
                                <td class="left">
                                  <a href="<%= root_url %>member_list/profile/<%= member.id %>" style="color: inherit; text-decoration: underline; cursor: pointer;">
                                    <%= member.mmbr_name %>
                                  </a>
                                </td>
                                <td>
                                  <% if member.mmbr_gender == 'M' %>Male
                                  <% elsif member.mmbr_gender == 'F' %>Female
                                  <% elsif member.mmbr_gender == 'Oth' %>Other
                                  <% else %>—
                                  <% end %>
                                </td>

                                <td><%= member.mmbr_contact %></td>

                                <%# --- NEW: Plan --- %>
                                <td>
                                  <% if plan %>
                                    <%= plan.plan_name %>
                                  <% else %>
                                    <span style="color:#aaa;">—</span>
                                  <% end %>
                                </td>

                                <%# --- NEW: Amount Paid --- %>
                                <td>
                                  <% if latest %>
                                    <strong>₹<%= number_with_delimiter(latest.ms_amount_paid.to_i) %></strong>
                                    <% if latest.ms_payment_mode.present? %>
                                      &nbsp;<span class="badge 
                                        <%= latest.ms_payment_mode.downcase == 'cash' ? 'badge-success' : 'badge-info' %>">
                                        <%= latest.ms_payment_mode.upcase %>
                                      </span>
                                    <% end %>
                                  <% else %>
                                    <span style="color:#aaa;">—</span>
                                  <% end %>
                                </td>

                                <%# --- NEW: Valid Till --- %>
                                <td>
                                  <% if latest %>
                                    <%= formatted_date(latest.ms_end_date) %>
                                    <br/>
                                    <% if days_left && days_left >= 0 %>
                                      <span class="badge <%= days_left <= 7 ? 'badge-danger' : days_left <= 30 ? 'badge-warning' : 'badge-success' %>"
                                            style="font-size:10px;">
                                        <%= days_left == 0 ? 'Expires today' : "#{days_left}d left" %>
                                      </span>
                                    <% end %>
                                  <% else %>
                                    <span style="color:#aaa;">—</span>
                                  <% end %>
                                </td>

                                <%# --- NEW: Status --- %>
                                <td>
                                  <% if latest.nil? %>
                                    <span class="badge badge-default">No Sub</span>
                                  <% elsif is_active %>
                                    <span class="badge badge-success">Active</span>
                                  <% else %>
                                    <span class="badge badge-danger">Expired</span>
                                  <% end %>
                                </td>

                            <td style="white-space: nowrap;">
                              <%# View profile %>
                              <a href="<%= root_url %>member_list/profile/<%= member.id %>"
                                title="View profile">
                                <i class="fa fa-eye" style="color:#5b9bd5; font-size:16px; margin-right:6px;"></i>
                              </a>

                              <%# Edit %>
                              <a href="<%= root_url %>member_list/add_member/<%= member.id %>"
                                class="tblEditBtn"
                                title="Edit member">
                                <i class="fa fa-pencil"></i>
                              </a>

                              <%# Delete %>
                              <a class="tblDelBtn"
                                title="Delete member"
                                onclick="alertChecked('<%= root_url %>member_list/<%= member.id %>/deletes')"
                                style="margin-left:6px;">
                                <i class="fa fa-trash-o"></i>
                              </a>

                              <%# Renew — only when expired or no subscription %>
                              <% latest = @latest_subscription_hash[member.id] %>
                              <% if latest.nil? || latest.ms_end_date < Date.today %>
                                <a href="<%= root_url %>member_subscriptions/add_member_subscriptions?renew=1&member_id=<%= member.id %>"
                                  title="Renew subscription"
                                  style="margin-left:6px;">
                                  <i class="fa fa-refresh" style="color:#f0a500; font-size:16px;"></i>
                                </a>
                              <% end %>
                            </td>
                              </tr>
                        <% i += 1 %>
                            <% end %>
                            <% end %>
                      </tbody>
                    </table>
										</div>
                     
                    <div class="col-md-12 text-center"></div>
                    
										</div>
									</div>
								</div>

                </div>
                </div>
                </div>
                </div>
                <div class="tab-pane" id="tab2">
										<div class="row">
								
											<div class="col-md-4">
												<div class="card card-box">
													<div class="card-body no-padding ">
														<div class="doctor-profile">
                          
															<img src="" class="doctor-pic img-thumbnail"
																alt="">
                            <img src="<%= root_url %>images/no-image.jpg" class="doctor-pic img-responsive img-thumbnail" alt="">
															<div class="profile-usertitle">
																<div class="doctor-name"></div>
																
                          <div class="name-center"></div>
                          <div class="name-center">Male</div>
                          <div class="name-center">Female</div>
                          <div class="name-center">Other</div>
                                 
															</div>
															<p><br /></p>
															<div>
																<p><i class="fa fa-phone"></i><a
																		href="tel:(123)456-7890"> </a></p>
															</div>
															<div class="profile-userbuttons">
																<a href="<%=root_url%>faculty_list/add_faculty"
																	class="btn btn-circle deepPink-bgcolor btn-sm">Edit</a>
								
															</div>
														</div>
													</div>
												</div>
											</div>
											
										</div>
								
									</div>
								</div>

        
			</div>
	 	</div>	 

    </div>
	<!-- End page container -->
</div>

