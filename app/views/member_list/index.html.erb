<div class="page-wrapper">
<%= render "layouts/header" %>
<!-- start page container -->
		<div class="page-container">
		<%= render "layouts/sidebar" %>
 <div class="page-content-wrapper">
    <div class="page-content" >
           
    <div class="page-bar">
						<div class="page-title-breadcrumb">
							<div class=" pull-left">
								<div class="page-title">Members List</div>
							</div>
							<%= render "layouts/breadcrumbs" %>
						</div>
            
					</div>
          <div class="row">
          <div class="col-md-12">
            <div class="tabbable-line">
              <ul class="nav customtab nav-tabs" role="tablist">
                <li class="nav-item"><a href="#tab1" class="nav-link active"
                    data-bs-toggle="tab">List
                    View</a></li>
              </ul>
              <div class="tab-content">
									<div class="tab-pane active fontawesome-demo" id="tab1">
					<div class="row">
						<div class="col-md-12">
							<div class="row">
								<div class="col-sm-12">
									<div class="card">
								
										<div class="card-body ">
                    <% if flash[:error] %>
                    <div class="alert <% if session[:isErrorhandled].to_i >0 %>alert-danger<% else %>alert-success<% end %>" style="width:900px;" id="successXMessage">
                      <span class="closebtn" onclick="this.parentElement.style.display='none';">&times;</span>
                      <%= flash[:error] %>
                    </div>
                   <% end %>

          <%= form_tag({:action=>'index'}, :multipart=>true, id: 'myForms') do %>
          <input type="hidden" id="rootXPath" value="<%=root_url%>"/>
          <input type="hidden" name="server_request" id="server_request" value="Y"/>

            <div class="row m-b-10 align-items-center">
              <div class="col-sm-12 col-md-12 d-flex justify-content-between align-items-center gap-2 flex-wrap">

                <%# On Roll is the working list. Removed is the archive — members
                    kept for their payment and subscription history. %>
                <div class="ml-view-switch" id="mlViewSwitch">
                  <button type="button" class="ml-view-btn is-on" data-view="active">
                    <i class="fa fa-users"></i> On Roll
                  </button>
                  <button type="button" class="ml-view-btn" data-view="removed">
                    <i class="fa fa-archive"></i> Removed
                  </button>
                </div>

                <a href="<%=root_url%>member_list/add_member">
                  <button type="button" class="btn btn-circle btn-success">
                    <i class="fa fa-plus"></i> Add Member
                  </button>
                </a>
              </div>
            </div>

            <div class="ml-archive-note" id="mlArchiveNote" hidden>
              <i class="fa fa-info-circle"></i>
              These members were removed from the list. Their subscriptions and
              payments are still in the system — that is why the records never
              show “Unknown member”. Use <i class="fa fa-undo"></i> to put someone back.
            </div>
          <% end %>
										<div class="table-loading-wrapper" id="member-table-wrapper">
                  <div class="table-loader-overlay" id="member-table-loader">
                    <div class="table-loader-spinner"></div>
                    <div class="table-loader-text">Loading members...</div>
                  </div>
                      <table
                      class="table table-striped table-bordered table-hover "
                      id="members_table" >
                      <thead>
                        <tr>
                          <th>S.No</th>
                          <th>Member Code</th>
                          <th>Member Name</th>
                          <th>Gender</th>
                          <th>Contact No.</th>
                          <th>Plan</th>
                          <th>Amount Paid</th>
                          <th>Valid Till</th>
                          <th>Status</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody>
                      
                      </tbody>
                    </table>
										</div>
                     
                    <div class="col-md-12 text-center"></div>
                    
										</div>
									</div>
								</div>

                </div>
                </div>
                </div>
                </div>
                <div class="tab-pane" id="tab2">
										<div class="row">
								
											<div class="col-md-4">
												<div class="card card-box">
													<div class="card-body no-padding ">
														<div class="doctor-profile">
                          
															<img src="" class="doctor-pic img-thumbnail"
																alt="">
                            <img src="<%= root_url %>images/no-image.jpg" class="doctor-pic img-responsive img-thumbnail" alt="">
															<div class="profile-usertitle">
																<div class="doctor-name"></div>
																
                          <div class="name-center"></div>
                          <div class="name-center">Male</div>
                          <div class="name-center">Female</div>
                          <div class="name-center">Other</div>
                                 
															</div>
															<p><br /></p>
															<div>
																<p><i class="fa fa-phone"></i><a
																		href="tel:(123)456-7890"> </a></p>
															</div>
															<div class="profile-userbuttons">
																<a href="<%=root_url%>faculty_list/add_faculty"
																	class="btn btn-circle deepPink-bgcolor btn-sm">Edit</a>
								
															</div>
														</div>
													</div>
												</div>
											</div>
											
										</div>
								
									</div>
								</div>

        
			</div>
	 	</div>	 

    </div>
	<!-- End page container -->
</div>

<%# ---------- Remove member dialog ---------- %>
<div class="ml-modal" id="mlRemoveModal">
  <div class="ml-modal-card">
    <div class="ml-modal-head ml-modal-head-warn">
      <i class="fa fa-user-times"></i>
      <span>Remove member from list</span>
    </div>
    <div class="ml-modal-body">
      <p class="ml-modal-lead">
        Remove <strong id="mlRemoveName"></strong> from the member list?
      </p>
      <ul class="ml-modal-points">
        <li><i class="fa fa-check"></i> Their subscriptions and payments stay in the system, so those records keep showing their name.</li>
        <li><i class="fa fa-check"></i> They disappear from the member list and from new subscription dropdowns.</li>
        <li><i class="fa fa-ban"></i> Gym access is revoked on the next device sync, even if their plan has days left.</li>
        <li><i class="fa fa-undo"></i> You can put them back any time from the <strong>Removed</strong> tab.</li>
      </ul>
      <label class="ml-modal-label" for="mlRemoveReason">Reason <span>(optional)</span></label>
      <input type="text" id="mlRemoveReason" class="form-control" maxlength="250"
             placeholder="e.g. Left the gym, shifted city, duplicate entry">
    </div>
    <div class="ml-modal-foot">
      <button type="button" class="btn btn-default" onclick="closeRemoveMember()">Cancel</button>
      <button type="button" class="btn btn-danger" id="mlRemoveConfirm">
        <i class="fa fa-trash-o"></i> Remove
      </button>
    </div>
  </div>
</div>
