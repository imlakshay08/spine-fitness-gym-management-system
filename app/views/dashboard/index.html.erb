<%
begin
%>
<div class="page-wrapper">
<%= render "layouts/header" %>

<div class="page-container">
  <%= render "layouts/sidebar" %>

  <div class="page-content-wrapper">
    <div class="page-content">

      <div class="page-bar">
        <div class="page-title-breadcrumb">
          <div class="pull-left">
            <div class="page-title">Dashboard</div>
          </div>
          <%= render "layouts/breadcrumbs" %>
        </div>
      </div>
<div class="dash-greeting" style="margin-bottom:24px;">
<h1>WELCOME BACK, <span class="accent"><%= session[:autherizedUserName]&.upcase || 'ADMIN' %>.</span></h1>
  <p>Here's what's happening at the gym today.</p>
</div>
<!-- Bridge Status Banner -->
<div id="bridge-status-banner" class="alert" style="margin-bottom:16px; padding:10px 16px; border-radius:6px; font-size:14px;">
  <% if @bridge_status[:status] == 'online' %>
    <span style="color:#28a745;">● Biometric Bridge: Online</span>
  <% elsif @bridge_status[:status] == 'warning' %>
    <span style="color:#ffc107;">⚠ Biometric Bridge: <%= @bridge_status[:label] %></span>
  <% else %>
    <span style="color:#dc3545;">
      ● Biometric Bridge: OFFLINE — <%= @bridge_status[:label] %>
    </span>
    <span style="color:#aaa; font-size:13px; margin-left:12px;">
      Go to gym laptop → double-click <strong>"Restart Biometric Bridge"</strong> on Desktop → wait 30 seconds
    </span>
  <% end %>
</div>
      <%= form_tag({ action: 'index' }, multipart: true, id: 'myForms') do %>
      <input type="hidden" id="rootXPath" value="<%= root_url %>">
      <input type="hidden" id="server_request" name="server_request" value="Y">

      <!-- ROW 1 : SUMMARY BOXES -->
      <div class="row">

    <!-- Live Attendance Feed -->
    <div class="row mt-4">
      <div class="col-md-12">
        <div class="card">
          <div class="card-head">
            <header>
              Live Attendance
                <span class="live-dot" style="margin-left:10px;">LIVE</span>
              <small class="text-muted ml-2" id="last-updated"></small>
            </header>
          </div>
          <div class="card-body p-0" style="max-height:300px; overflow:auto;">
            <table class="table table-bordered table-hover mb-0">
              <thead>
                <tr>
                  <th>Member</th>
                  <th>Time</th>
                  <th>Subscription</th>
                  <th>Access</th>
                </tr>
              </thead>
              <tbody id="live-attendance-body">
                <tr>
                  <td colspan="4" class="text-center text-muted py-3">
                    Waiting for attendance...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

        <div class="row mb-4">

          <div class="col-md-3">
            <div class="card text-center stat-accent accent-orange">
              <div class="card-body">
                <div class="stat-icon-box orange"><i class="fa-solid fa-check-circle"></i></div>
                <h4><%= @active_count %></h4>
                <p>Active Subscriptions</p>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="card text-center stat-accent accent-yellow">
              <div class="card-body">
                <div class="stat-icon-box yellow"><i class="fa-solid fa-clock"></i></div>
                <h4><%= @expiring_count %></h4>
                <p>Expiring Subscriptions(7 Days)</p>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="card text-center stat-accent accent-red">
              <div class="card-body">
                <div class="stat-icon-box red"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <h4><%= @expired_count %></h4>
                <p>Expired Subscriptions</p>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="card text-center stat-accent accent-green">
              <div class="card-body">
                <div class="stat-icon-box green"><i class="fa-solid fa-rupee-sign"></i></div>
                <h4>₹ <%= @today_collection %></h4>
                <p>Today's Collection</p>
              </div>
            </div>
          </div>

        </div>

        <!-- EXPIRED SUBSCRIPTIONS -->
<div class="col-md-4">
  <div class="card h-100">
    <div class="card-head">
      <header>Expired Subscriptions</header>
    </div>

    <div class="card-body p-0" style="max-height:280px; overflow:auto;">
      <ul class="list-group list-group-flush">
        <% @expired_subs.each do |sub| %>
          <% mem = get_member_detail(sub.ms_member_id) %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="<%= root_url %>member_list/profile/<%= sub.ms_member_id %>"
              style="color:inherit; text-decoration:underline;">
              <%= mem&.mmbr_name || "Unknown Member" %>
            </a>
            <span class="text-danger" style="font-size:12px;">
              <%= sub.ms_end_date.strftime("%d-%b") %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

<div class="col-md-4">
  <div class="card h-100">
    <div class="card-head">
      <header>Expiring Soon Subscriptions</header>
    </div>

    <div class="card-body p-0" style="max-height:280px; overflow:auto;">
      <ul class="list-group list-group-flush">
        <% @expiring_subs.each do |sub| %>
          <% mem = get_member_detail(sub.ms_member_id) %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="<%= root_url %>member_list/profile/<%= sub.ms_member_id %>"
              style="color:inherit; text-decoration:underline;">
              <%= mem&.mmbr_name || "Unknown Member" %>
            </a>
            <span class="text-warning" style="font-size:12px;">
              <%= sub.ms_end_date.strftime("%d-%b") %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

<div class="col-md-4">
  <div class="card h-100">
    <div class="card-head">
      <header>Active Subscriptions</header>
    </div>

    <div class="card-body p-0" style="max-height:280px; overflow:auto;">
      <ul class="list-group list-group-flush">
        <% @active_subs.each do |sub| %>
          <% mem = get_member_detail(sub.ms_member_id) %>
          <li class="list-group-item d-flex justify-content-between">
            <span><%= mem&.mmbr_name || "Unknown Member" %></span>
            <span>
              <%= payment_status(sub) %> |
              <%= sub.ms_end_date.strftime("%d-%b") %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-12">
    <div class="card">
      <div class="card-head"><header>Members With Due</header></div>
      <div class="card-body">
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Member(Contact)</th>
              <th>Plan</th>
              <th>Final Amount</th>
              <th>Paid</th>
              <th>Due</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @due_members.each do |sub| %>
              <% mem = get_member_detail(sub.ms_member_id) %>
              <%
              														planobj = get_plan_detail(sub.ms_plan_id)
                            if planobj
                               planname = planobj.plan_name
                            end
              %>
              <tr>
                <td><%= mem&.mmbr_name || "Unknown Member" %>(<%=mem&.mmbr_contact%>)</td>
                <td><%= planname %></td>
                <td>₹ <%= sub.ms_final_amount %></td>
                <td>₹ <%= total_paid(sub) %></td>
                <td class="text-danger">₹ <%= due_amount(sub) %></td>
                <td>
                  <button type="button" class="btn btn-sm btn-warning"
                    onclick="openCollectPayment(<%= sub.id %>, <%= due_amount(sub).to_i %>, '<%= j("#{mem&.mmbr_name} (#{mem&.mmbr_contact})") %>')">
                    <i class="fa fa-money"></i> Collect
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- COLLECT PAYMENT MODAL (shared by the due-members rows) -->
<div id="collectPaymentModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9999;">
  <div style="background:#1e1e2d; color:#fff; max-width:460px; margin:7% auto; padding:24px; border-radius:8px; box-shadow:0 8px 30px rgba(0,0,0,0.5);">
    <h4 style="margin:0 0 6px;">Collect Payment</h4>
    <p id="cp_member_label" style="margin:0 0 16px; color:#aaa;"></p>
    <input type="hidden" id="cp_subscription_id" value="">

    <div class="form-group">
      <label>Amount (₹)</label>
      <input type="number" id="cp_amount" class="form-control" value="" min="1">
    </div>
    <div class="form-group">
      <label>Payment Mode</label>
      <select id="cp_mode" class="form-control">
        <option value="cash">Cash</option>
        <option value="upi">UPI</option>
      </select>
    </div>
    <div class="form-group">
      <label>Date</label>
      <input type="text" id="cp_date" class="form-control" value="<%= Date.today.strftime('%d-%b-%Y') %>">
    </div>
    <div class="form-group">
      <label>Remarks (optional)</label>
      <input type="text" id="cp_remarks" class="form-control" placeholder="e.g. cleared balance">
    </div>

    <div style="text-align:right; margin-top:18px;">
      <button type="button" class="btn btn-default" onclick="closeCollectPayment();">Cancel</button>
      <button type="button" class="btn btn-success" id="cp_save_btn" onclick="submitCollectPayment();">Save Payment</button>
    </div>
  </div>
</div>



      <% end %> <!-- form -->

    </div> <!-- page-content -->
  </div> <!-- wrapper -->
</div> <!-- container -->

<%
rescue => e
  message = "Error: #{e.message}"
end
%>

<%= message %>
