<%# WhatsApp-style Inbox — spine-fitness.com %>
<%# Drop this file into app/views/whatsapp_inbox/index.html.erb %>

<style>
  /* ── Reset & shell ── */
  .wa-shell {
    display: flex;
    height: calc(100vh - 64px); /* subtract your nav height */
    background: #111b21;
    border-radius: 12px;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    box-shadow: 0 4px 32px rgba(0,0,0,0.4);
  }

  /* ── Left panel: conversation list ── */
  .wa-sidebar {
    width: 360px;
    min-width: 300px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid #2a3942;
    background: #111b21;
  }

  .wa-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: #202c33;
    border-bottom: 1px solid #2a3942;
  }

  .wa-sidebar-header h2 {
    font-size: 18px;
    font-weight: 600;
    color: #e9edef;
    margin: 0;
  }

  .wa-badge {
    background: #00a884;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 20px;
  }

  .wa-search {
    padding: 8px 12px;
    background: #111b21;
    border-bottom: 1px solid #2a3942;
  }

  .wa-search input {
    width: 100%;
    background: #202c33;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    color: #e9edef;
    font-size: 14px;
    outline: none;
  }

  .wa-search input::placeholder { color: #667781; }

  .wa-conv-list {
    flex: 1;
    overflow-y: auto;
  }

  .wa-conv-list::-webkit-scrollbar { width: 4px; }
  .wa-conv-list::-webkit-scrollbar-track { background: transparent; }
  .wa-conv-list::-webkit-scrollbar-thumb { background: #2a3942; border-radius: 4px; }

  .wa-conv-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    cursor: pointer;
    border-bottom: 1px solid #1e2a30;
    transition: background 0.1s;
    text-decoration: none;
  }

  .wa-conv-item:hover { background: #1e2a30; }
  .wa-conv-item.active { background: #2a3942; }

  .wa-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #00a884;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    text-transform: uppercase;
  }

  .wa-conv-info { flex: 1; min-width: 0; }

  .wa-conv-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 3px;
  }

  .wa-conv-name {
    font-size: 15px;
    font-weight: 600;
    color: #e9edef;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }

  .wa-conv-time {
    font-size: 11px;
    color: #667781;
    flex-shrink: 0;
  }

  .wa-conv-time.unread { color: #00a884; }

  .wa-conv-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .wa-conv-preview {
    font-size: 13px;
    color: #8696a0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
  }

  .wa-unread-dot {
    background: #00a884;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ── Right panel: chat thread ── */
  .wa-chat {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #0b141a;
    position: relative;
  }

  /* subtle background pattern */
  .wa-chat::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23182229' fill-opacity='0.6'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
    opacity: 0.4;
  }

  .wa-chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #202c33;
    border-bottom: 1px solid #2a3942;
    position: relative;
    z-index: 1;
  }

  .wa-chat-header-name {
    font-size: 16px;
    font-weight: 600;
    color: #e9edef;
  }

  .wa-chat-header-sub {
    font-size: 12px;
    color: #8696a0;
  }

  .wa-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    z-index: 1;
  }

  .wa-messages::-webkit-scrollbar { width: 4px; }
  .wa-messages::-webkit-scrollbar-track { background: transparent; }
  .wa-messages::-webkit-scrollbar-thumb { background: #2a3942; border-radius: 4px; }

  .wa-date-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 12px 0;
  }

  .wa-date-divider span {
    background: #182229;
    color: #8696a0;
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 8px;
  }

  /* Incoming bubble (member → gym) */
  .wa-bubble-in {
    align-self: flex-start;
    background: #202c33;
    color: #e9edef;
    padding: 7px 12px 6px;
    border-radius: 0 8px 8px 8px;
    max-width: 65%;
    position: relative;
    word-break: break-word;
  }

  .wa-bubble-in::before {
    content: '';
    position: absolute;
    top: 0; left: -8px;
    border: 8px solid transparent;
    border-top-color: #202c33;
    border-right-color: #202c33;
    border-top-right-radius: 2px;
  }

  /* Outgoing bubble (gym → member) */
  .wa-bubble-out {
    align-self: flex-end;
    background: #005c4b;
    color: #e9edef;
    padding: 7px 12px 6px;
    border-radius: 8px 0 8px 8px;
    max-width: 65%;
    position: relative;
    word-break: break-word;
  }

  .wa-bubble-out::after {
    content: '';
    position: absolute;
    top: 0; right: -8px;
    border: 8px solid transparent;
    border-top-color: #005c4b;
    border-left-color: #005c4b;
    border-top-left-radius: 2px;
  }

  .wa-bubble-text {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }

  .wa-bubble-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    margin-top: 3px;
  }

  .wa-bubble-time {
    font-size: 11px;
    color: #8696a0;
  }

  .wa-bubble-out .wa-bubble-time { color: #9ab0ab; }

  .wa-tick { font-size: 13px; color: #53bdeb; }

  /* Auto-message label */
  .wa-auto-label {
    font-size: 10px;
    color: #00a884;
    display: block;
    margin-bottom: 3px;
    font-weight: 500;
  }

  /* Reply box */
  .wa-reply-box {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 12px 16px;
    background: #202c33;
    border-top: 1px solid #2a3942;
    position: relative;
    z-index: 1;
  }

  .wa-reply-input {
    flex: 1;
    background: #2a3942;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    color: #e9edef;
    font-size: 15px;
    resize: none;
    outline: none;
    max-height: 120px;
    min-height: 42px;
    line-height: 1.4;
    font-family: inherit;
  }

  .wa-reply-input::placeholder { color: #667781; }

  .wa-send-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #00a884;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .wa-send-btn:hover { background: #06cf9c; }

  .wa-send-btn svg { width: 20px; height: 20px; fill: #fff; }

  /* Empty state */
  .wa-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #667781;
    gap: 12px;
    position: relative;
    z-index: 1;
  }

  .wa-empty svg { width: 80px; height: 80px; opacity: 0.2; }
  .wa-empty p { font-size: 15px; }

  /* No conversations */
  .wa-no-conv {
    padding: 32px 16px;
    text-align: center;
    color: #667781;
    font-size: 14px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .wa-sidebar { width: 100%; display: <%= @active_chat ? 'none' : 'flex' %>; }
    .wa-chat { display: <%= @active_chat ? 'flex' : 'none' %>; }
  }
</style>

<div class="wa-shell">

  <%# ── LEFT: Conversation list ── %>
  <div class="wa-sidebar">
    <div class="wa-sidebar-header">
      <h2>💬 Inbox</h2>
      <% if @total_unreplied > 0 %>
        <span class="wa-badge"><%= @total_unreplied %> new</span>
      <% end %>
    </div>

    <div class="wa-search">
      <input type="text" placeholder="Search conversations..." id="wa-search-input" />
    </div>

    <div class="wa-conv-list" id="wa-conv-list">
      <% if @conversations.empty? %>
        <div class="wa-no-conv">
          No messages yet.<br>Members who reply to automated alerts will appear here.
        </div>
      <% else %>
        <% @conversations.each do |conv| %>
          <a href="<%= whatsapp_inbox_index_path(number: conv[:number]) %>"
             class="wa-conv-item <%= 'active' if conv[:number] == @active_number %>"
             data-name="<%= conv[:name].downcase %>">

            <div class="wa-avatar">
              <%= conv[:name].first rescue '?' %>
            </div>

            <div class="wa-conv-info">
              <div class="wa-conv-top">
                <span class="wa-conv-name"><%= conv[:name] %></span>
                <span class="wa-conv-time <%= 'unread' if conv[:unread] > 0 %>">
                  <%= conv[:last_time].strftime("%d %b") %>
                </span>
              </div>
              <div class="wa-conv-bottom">
                <span class="wa-conv-preview">
                  <%= truncate(conv[:last_message] || '📎 Media', length: 40) %>
                </span>
                <% if conv[:unread] > 0 %>
                  <span class="wa-unread-dot"><%= conv[:unread] %></span>
                <% end %>
              </div>
            </div>
          </a>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── RIGHT: Chat thread ── %>
  <div class="wa-chat">
    <% if @active_chat %>

      <div class="wa-chat-header">
        <div class="wa-avatar" style="width:38px;height:38px;font-size:15px;">
          <%= @active_chat[:name].first rescue '?' %>
        </div>
        <div>
          <div class="wa-chat-header-name"><%= @active_chat[:name] %></div>
          <div class="wa-chat-header-sub">+<%= @active_chat[:number] %></div>
        </div>
      </div>

      <div class="wa-messages" id="wa-messages">
        <%
          messages     = @active_chat[:messages]
          current_date = nil
        %>

        <% messages.each do |msg| %>
          <%
            msg_date = msg.wi_received_at.to_date
            if msg_date != current_date
              current_date = msg_date
          %>
            <div class="wa-date-divider">
              <span>
                <% if msg_date == Date.today %>
                  Today
                <% elsif msg_date == Date.yesterday %>
                  Yesterday
                <% else %>
                  <%= msg_date.strftime("%d %b %Y") %>
                <% end %>
              </span>
            </div>
          <% end %>

          <%# Incoming message from member %>
          <div class="wa-bubble-in">
            <p class="wa-bubble-text"><%= msg.wi_body.presence || "📎 Media message" %></p>
            <div class="wa-bubble-meta">
              <span class="wa-bubble-time">
                <%= msg.wi_received_at.strftime("%I:%M %p") %>
              </span>
            </div>
          </div>

          <%# Show reply bubble if replied %>
          <% if msg.wi_replied? && msg.wi_reply_text.present? %>
            <div class="wa-bubble-out">
              <span class="wa-auto-label">↩ <%= msg.wi_replied_by || 'Staff' %></span>
              <p class="wa-bubble-text"><%= msg.wi_reply_text %></p>
              <div class="wa-bubble-meta">
                <span class="wa-bubble-time">
                  <%= msg.wi_replied_at&.strftime("%I:%M %p") %>
                </span>
                <span class="wa-tick">✓✓</span>
              </div>
            </div>
          <% end %>
        <% end %>

        <%# Automated messages sent TO this member %>
        <%
          member_phone = @active_chat[:number].to_s.last(10)
          member_obj   = MstMembersList.find_by(mmbr_contact: member_phone)
        %>
        <% if member_obj %>
          <%
            auto_logs = TrnWhatsappLog
              .where(wl_member_id: member_obj.id, wl_compcode: 'SF')
              .where(wl_status: %w[DELIVERED READ QUEUED])
              .order(:wl_sent_at)
          %>
          <% auto_logs.each do |log| %>
            <div class="wa-bubble-out">
              <span class="wa-auto-label">🤖 Automated</span>
              <p class="wa-bubble-text">
                <%= log.wl_message_body.presence || log.wl_template_name.humanize %>
              </p>
              <div class="wa-bubble-meta">
                <span class="wa-bubble-time">
                  <%= log.wl_sent_at.strftime("%I:%M %p") %>
                </span>
                <% if log.wl_status == 'READ' %>
                  <span class="wa-tick">✓✓</span>
                <% elsif log.wl_status == 'DELIVERED' %>
                  <span class="wa-tick" style="color:#8696a0">✓✓</span>
                <% else %>
                  <span class="wa-tick" style="color:#667781">✓</span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <%# Reply box — uses the last unreplied message id %>
      <%
        last_msg = @active_chat[:messages].last
      %>
      <% if last_msg %>
        <%= form_with url: reply_whatsapp_inbox_path(last_msg), method: :post,
                      class: 'wa-reply-box', id: 'wa-reply-form' do |f| %>
          <%= f.text_area :reply_text,
              placeholder: "Type a message",
              class: 'wa-reply-input',
              id: 'wa-reply-input',
              rows: 1 %>

          <%= f.button type: 'submit', class: 'wa-send-btn' do %>
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M1.101 21.757L23.8 12.028 1.101 2.3l.011 7.912 13.623 1.816-13.623 1.817-.011 7.912z"/>
            </svg>
          <% end %>
        <% end %>
      <% end %>

    <% else %>
      <div class="wa-empty">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z" fill="currentColor"/>
        </svg>
        <p>Select a conversation to start chatting</p>
      </div>
    <% end %>
  </div>

</div>

<script>
  // Auto-scroll messages to bottom
  const msgs = document.getElementById('wa-messages');
  if (msgs) msgs.scrollTop = msgs.scrollHeight;

  // Auto-resize textarea
  const input = document.getElementById('wa-reply-input');
  if (input) {
    input.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });

    // Send on Enter (Shift+Enter for newline)
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        document.getElementById('wa-reply-form')?.submit();
      }
    });
  }

  // Search conversations
  const searchInput = document.getElementById('wa-search-input');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const q = this.value.toLowerCase();
      document.querySelectorAll('.wa-conv-item').forEach(item => {
        const name = item.dataset.name || '';
        item.style.display = name.includes(q) ? 'flex' : 'none';
      });
    });
  }
</script>
