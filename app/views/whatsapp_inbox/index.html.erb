<div class="container">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2>📱 WhatsApp Inbox</h2>
    <span style="background:#25D366; color:white; padding:4px 12px; border-radius:20px; font-size:13px;">
      <%= @unreplied_count %> unreplied
    </span>
  </div>

  <% if @messages.empty? %>
    <p style="color:#888; text-align:center; margin-top:60px;">
      No messages yet. Members who reply to automated messages will appear here.
    </p>
  <% else %>
    <% @messages.each do |msg| %>
      <div style="border:1px solid #e0e0e0; border-radius:8px; padding:16px; margin-bottom:12px;
                  <%= msg.wi_replied? ? 'background:#f9f9f9' : 'background:#fff8e1' %>">

        <div style="display:flex; justify-content:space-between; align-items:center;">
          <div>
            <strong><%= msg.display_name %></strong>
            <span style="color:#888; font-size:12px; margin-left:8px;">
              +<%= msg.wi_from_number %>
            </span>
            <% unless msg.wi_replied? %>
              <span style="background:#ff9800; color:white; font-size:11px;
                           padding:2px 8px; border-radius:10px; margin-left:8px;">
                New
              </span>
            <% end %>
          </div>
          <span style="color:#888; font-size:12px;">
            <%= msg.wi_received_at.strftime("%d %b %Y, %I:%M %p") %>
          </span>
        </div>

        <p style="margin:10px 0 0; color:#333;">
          <%= msg.wi_body %>
        </p>

        <% if msg.wi_replied? %>
          <div style="margin-top:10px; padding:8px 12px; background:#e8f5e9;
                      border-radius:6px; font-size:13px; color:#2e7d32;">
            ✅ Replied by <%= msg.wi_replied_by %> at
            <%= msg.wi_replied_at&.strftime("%d %b, %I:%M %p") %>:
            "<%= msg.wi_reply_text %>"
          </div>
        <% else %>
          <%= form_with url: reply_whatsapp_inbox_path(msg), method: :post,
                        style: "margin-top:12px; display:flex; gap:8px;" do |f| %>
            <%= f.text_field :reply_text,
                placeholder: "Type your reply...",
                style: "flex:1; padding:8px 12px; border:1px solid #ddd;
                        border-radius:6px; font-size:14px;" %>
            <%= f.submit "Send →",
                style: "background:#25D366; color:white; border:none;
                        padding:8px 16px; border-radius:6px; cursor:pointer;" %>
          <% end %>
        <% end %>

      </div>
    <% end %>
  <% end %>
</div>