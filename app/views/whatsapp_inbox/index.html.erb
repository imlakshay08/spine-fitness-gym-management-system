<div class="page-wrapper">
  <%= render "layouts/header" %>

  <div class="page-container">
    <%= render "layouts/sidebar" %>

    <div class="page-content-wrapper">
      <div class="page-content wai-page">

        <div class="page-bar">
          <div class="page-title-breadcrumb">
            <div class="pull-left">
              <div class="page-title">WhatsApp Inbox</div>
            </div>
            <%= render "layouts/breadcrumbs" %>
          </div>
        </div>

        <div class="wai-shell <%= 'is-empty' unless @active_chat %>"
             id="waInbox"
             data-base="<%= root_url %>whatsapp_inbox"
             data-token="<%= form_authenticity_token %>"
             data-number="<%= @active_number %>"
             data-cursor="<%= @cursor %>">

          <%# ── Conversations ─────────────────────────────────────────── %>
          <aside class="wai-pane wai-pane-list">
            <div class="wai-pane-head">
              <div class="wai-pane-title">
                <i class="fa-brands fa-whatsapp"></i> Conversations
              </div>
              <span class="wai-live" id="waLive" title="Live — new messages arrive on their own">
                <span class="wai-live-dot"></span> Live
              </span>
            </div>

            <div class="wai-search">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="text" id="waSearch" placeholder="Search name or number" autocomplete="off">
            </div>

            <div class="wai-filters">
              <button type="button" class="wai-chip is-on" data-filter="all">All</button>
              <button type="button" class="wai-chip" data-filter="unread">
                Unread <span class="wai-chip-count" id="waUnreadCount"><%= @total_unread %></span>
              </button>
            </div>

            <div class="wai-conv-list" id="waConvList">
              <%= render partial: 'conversation_list',
                         locals: { conversations: @conversations, active_number: @active_number } %>
            </div>
          </aside>

          <%# ── Thread ────────────────────────────────────────────────── %>
          <section class="wai-pane wai-pane-chat">

            <div class="wai-chat-head">
              <button type="button" class="wai-icon-btn wai-back" id="waBack" title="Back to conversations">
                <i class="fa-solid fa-arrow-left"></i>
              </button>

              <span class="wai-avatar wai-tone-<%= wa_avatar_tone(@active_chat ? @active_chat[:name] : '') %>" id="waChatAvatar">
                <%= @active_chat ? @active_chat[:initial] : '?' %>
              </span>

              <div class="wai-chat-who">
                <div class="wai-chat-name" id="waChatName"><%= @active_chat ? @active_chat[:name] : 'No conversation selected' %></div>
                <div class="wai-chat-phone" id="waChatPhone">
                  <%= @active_chat ? "+#{@active_chat[:number]}" : 'Pick a chat on the left' %>
                </div>
              </div>

              <button type="button" class="wai-icon-btn" id="waCtxToggle" title="Member details">
                <i class="fa-solid fa-circle-info"></i>
              </button>
            </div>

            <div class="wai-window">
              <div class="wai-banner" id="waBanner" <%= 'hidden' if @session_open || !@active_chat %>>
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>
                  The 24-hour reply window has closed. WhatsApp only accepts approved
                  templates until this member messages again — a free reply sent now will be rejected.
                </span>
              </div>

              <div class="wai-messages" id="waMessages">
                <% if @active_chat %>
                  <%= render partial: 'message', collection: @messages, as: :item %>
                <% end %>
              </div>

              <button type="button" class="wai-jump" id="waJump" hidden>
                <i class="fa-solid fa-arrow-down"></i> <span id="waJumpLabel">New messages</span>
              </button>

              <div class="wai-empty" id="waEmpty">
                <i class="fa-regular fa-comment-dots"></i>
                <h4>Nothing selected</h4>
                <p>Choose a conversation to read and reply to it.</p>
              </div>
            </div>

            <div class="wai-composer">
              <div class="wai-quick" id="waQuick">
                <button type="button" class="wai-chip" data-text="Hi! Gym timings are 6:00 AM – 10:00 AM and 5:00 PM – 10:00 PM, Monday to Saturday.">⏰ Timings</button>
                <button type="button" class="wai-chip" data-text="Your membership is due for renewal. Visit the reception or reply here and we will help you renew.">🔁 Renewal</button>
                <button type="button" class="wai-chip" data-text="Sure, please share your name and the plan you are interested in and we will send you the details.">💳 Plans</button>
                <button type="button" class="wai-chip" data-text="Thanks for reaching out to Spine Fitness. We will get back to you shortly.">🙏 Thanks</button>
              </div>

              <div class="wai-composer-row">
                <textarea id="waInput" class="wai-input" rows="1" placeholder="Type a message"
                          <%= 'disabled' unless @active_chat %>></textarea>
                <button type="button" class="wai-send" id="waSend" <%= 'disabled' unless @active_chat %> title="Send (Enter)">
                  <i class="fa-solid fa-paper-plane"></i>
                </button>
              </div>
              <div class="wai-composer-hint">
                <span><kbd>Enter</kbd> to send · <kbd>Shift</kbd>+<kbd>Enter</kbd> for a new line</span>
                <span id="waSendState"></span>
              </div>
            </div>
          </section>

          <%# ── Member context ────────────────────────────────────────── %>
          <aside class="wai-pane wai-pane-ctx" id="waContext">
            <% if @active_chat %>
              <%= render partial: 'context', locals: { context: @context } %>
            <% end %>
          </aside>

        </div>
      </div>
    </div>
  </div>
</div>
