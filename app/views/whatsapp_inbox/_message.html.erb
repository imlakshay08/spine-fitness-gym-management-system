<%# One message in the thread. Rendered on first paint, on thread switch and
    on every poll, so the markup lives in exactly one place. %>
<div class="wai-row wai-row-<%= item[:dir] %>"
     data-key="<%= item[:key] %>"
     data-epoch="<%= item[:at].to_i %>"
     data-day="<%= wa_ist(item[:at]).to_date %>"
     data-day-label="<%= wa_day_label(item[:at]) %>">

  <%
    media    = item[:media]
    kind     = item[:msg_type].to_s
    # Only strip the bubble when there is actually a sticker image to show.
    # A sticker with no media (received before media was stored, or expired at
    # Meta) still needs a normal bubble, or it renders as an empty black box.
    sticker_image = kind == 'sticker' && media.present?
  %>

  <div class="wai-bubble wai-bubble-<%= item[:kind] %>
              <%= 'wai-bubble-failed' if item[:status].to_s.upcase == 'FAILED' %>
              <%= 'wai-bubble-sticker' if sticker_image %>">

    <% if item[:kind] == 'auto' && !sticker_image %>
      <span class="wai-tag wai-tag-auto" title="<%= item[:template] %>">
        <i class="fa-solid fa-bolt"></i> Automated
      </span>
    <% elsif item[:kind] == 'staff' && !sticker_image %>
      <span class="wai-tag wai-tag-staff">
        <i class="fa-solid fa-headset"></i> <%= item[:author].presence || 'Staff' %>
      </span>
    <% end %>

    <% if media.present? %>
      <% case kind %>
      <% when 'sticker' %>
        <img class="wai-sticker" src="<%= media[:url] %>" alt="Sticker" loading="lazy">

      <% when 'image' %>
        <a class="wai-media-link" href="<%= media[:url] %>" target="_blank" rel="noopener" title="Open full size">
          <img class="wai-photo" src="<%= media[:url] %>" alt="Photo" loading="lazy">
        </a>

      <% when 'video' %>
        <video class="wai-video" controls preload="metadata" src="<%= media[:url] %>"></video>

      <% when 'audio', 'voice' %>
        <audio class="wai-audio" controls preload="none" src="<%= media[:url] %>"></audio>

      <% else %>
        <a class="wai-file" href="<%= media[:download] %>">
          <span class="wai-file-icon"><i class="fa-solid fa-file-lines"></i></span>
          <span class="wai-file-body">
            <span class="wai-file-name"><%= media[:name].presence || kind.humanize %></span>
            <span class="wai-file-meta"><%= media[:mime].presence || 'File' %> · tap to download</span>
          </span>
        </a>
      <% end %>

      <% if %w[image video sticker].include?(kind) %>
        <a class="wai-media-save" href="<%= media[:download] %>">
          <i class="fa-solid fa-download"></i> Save
        </a>
      <% end %>
    <% end %>

    <% if item[:body].present? %>
      <p class="wai-text"><%= item[:body] %></p>
    <% elsif media.blank? %>
      <p class="wai-text wai-text-muted">
        <%= kind == 'sticker' ? 'Sticker — not saved' : "#{kind.presence&.humanize || 'Unsupported'} message" %>
      </p>
    <% end %>

    <div class="wai-meta">
      <span class="wai-time"><%= wa_clock(item[:at]) %></span>
      <% if item[:dir] == 'out' %>
        <span class="wai-tick-slot" title="<%= wa_status_label(item[:status]) %>"><%= wa_ticks(item[:status]) %></span>
      <% end %>
    </div>

    <%# Reactions hang off the bottom edge of the bubble, as in WhatsApp. %>
    <% if item[:reactions].present? %>
      <span class="wai-reactions" title="<%= item[:reactions].join(' ') %>">
        <%= item[:reactions].uniq.join %><%= item[:reactions].size if item[:reactions].size > 1 %>
      </span>
    <% end %>

    <% if item[:error].present? %>
      <div class="wai-error" title="<%= item[:error] %>">
        <i class="fa-solid fa-triangle-exclamation"></i> <%= truncate(item[:error].to_s, length: 150) %>
      </div>
    <% end %>
  </div>
</div>
