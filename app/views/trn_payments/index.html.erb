<div class="page-wrapper">
<%= render "layouts/header" %>
<div class="page-container">
<%= render "layouts/sidebar" %>
<div class="page-content-wrapper">
<div class="page-content">

<div class="page-bar">
  <div class="page-title-breadcrumb">
    <div class="pull-left">
      <div class="page-title">Payment Reports</div>
    </div>
    <%= render "layouts/breadcrumbs" %>
  </div>
</div>

<%# ─── Summary Cards ─────────────────────────────────────── %>
<div class="row" style="margin-bottom: 18px;">

  <div class="col-md-3 col-sm-6">
    <div class="card" style="border-left: 4px solid #26a69a; border-radius:6px;">
      <div class="card-body" style="padding: 16px 20px;">
        <div style="font-size:12px; color:#888; text-transform:uppercase; letter-spacing:1px;">Total Collected</div>
        <div style="font-size:26px; font-weight:700; color:#26a69a;">₹<%= number_with_delimiter(@total_collected.to_i) %></div>
        <div style="font-size:12px; color:#aaa;"><%= @total_count %> payment(s)</div>
      </div>
    </div>
  </div>

  <div class="col-md-3 col-sm-6">
    <div class="card" style="border-left: 4px solid #42a5f5; border-radius:6px;">
      <div class="card-body" style="padding: 16px 20px;">
        <div style="font-size:12px; color:#888; text-transform:uppercase; letter-spacing:1px;">Cash</div>
        <div style="font-size:26px; font-weight:700; color:#42a5f5;">₹<%= number_with_delimiter(@total_cash.to_i) %></div>
        <div style="font-size:12px; color:#aaa;"><%= @payments.count { |p| p.pay_mode.to_s.downcase == 'cash' } %> payment(s)</div>
      </div>
    </div>
  </div>

  <div class="col-md-3 col-sm-6">
    <div class="card" style="border-left: 4px solid #ab47bc; border-radius:6px;">
      <div class="card-body" style="padding: 16px 20px;">
        <div style="font-size:12px; color:#888; text-transform:uppercase; letter-spacing:1px;">UPI</div>
        <div style="font-size:26px; font-weight:700; color:#ab47bc;">₹<%= number_with_delimiter(@total_upi.to_i) %></div>
        <div style="font-size:12px; color:#aaa;"><%= @payments.count { |p| p.pay_mode.to_s.downcase == 'upi' } %> payment(s)</div>
      </div>
    </div>
  </div>

  <div class="col-md-3 col-sm-6">
    <div class="card" style="border-left: 4px solid #ef5350; border-radius:6px;">
      <div class="card-body" style="padding: 16px 20px;">
        <div style="font-size:12px; color:#888; text-transform:uppercase; letter-spacing:1px;">Other / Not Set</div>
        <%
          other_total = @payments.reject { |p| ['cash','upi'].include?(p.pay_mode.to_s.downcase) }.sum { |p| p.pay_amount.to_f }
          other_count = @payments.count   { |p| ['cash','upi'].exclude?(p.pay_mode.to_s.downcase) }
        %>
        <div style="font-size:26px; font-weight:700; color:#ef5350;">₹<%= number_with_delimiter(other_total.to_i) %></div>
        <div style="font-size:12px; color:#aaa;"><%= other_count %> payment(s)</div>
      </div>
    </div>
  </div>

</div>

<%# ─── Plan-wise Summary Bar ──────────────────────────────── %>
<% if @plan_wise.any? %>
<div class="row" style="margin-bottom: 18px;">
  <div class="col-md-12">
    <div class="card" style="border-radius:6px;">
      <div class="card-body" style="padding: 16px 20px;">
        <div style="font-size:13px; font-weight:600; color:#555; margin-bottom:12px;">Collection by Plan</div>
        <div class="row">
          <% plan_colors = ['#26a69a','#42a5f5','#ab47bc','#ef5350','#ffa726'] %>
          <% @plan_wise.each_with_index do |(plan_name, data), idx| %>
          <div class="col-md-2 col-sm-4" style="margin-bottom:8px;">
            <div style="border-left:3px solid <%= plan_colors[idx % plan_colors.size] %>; padding-left:10px;">
              <div style="font-size:11px; color:#999;"><%= plan_name %></div>
              <div style="font-size:16px; font-weight:700; color:<%= plan_colors[idx % plan_colors.size] %>;">₹<%= number_with_delimiter(data[:total].to_i) %></div>
              <div style="font-size:11px; color:#bbb;"><%= data[:count] %> member(s)</div>
            </div>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>

<%# ─── Filters ────────────────────────────────────────────── %>
<div class="row">
  <div class="col-md-12">
    <div class="card" style="border-radius:6px;">
      <div class="card-body">

        <%= form_tag({ action: 'index' }, :multipart=>true, id: 'paymentFilterForm') do %>
        <div class="row" style="align-items:flex-end;">

          <div class="col-md-2">
            <label style="font-size:12px; color:#777;">From Date</label>
            <div class="input-group">
              <span class="input-group-addon iconinput-pd"><i class="fa fa-calendar"></i></span>
              <input type="text" name="from_date" id="payments_from_date" class="form-control"
                     placeholder="From Date" autocomplete="off"
                     value="<%= @from_date.strftime('%d-%b-%Y') %>"/>
            </div>
          </div>

          <div class="col-md-2">
            <label style="font-size:12px; color:#777;">To Date</label>
            <div class="input-group">
              <span class="input-group-addon iconinput-pd"><i class="fa fa-calendar"></i></span>
              <input type="text" name="to_date" id="payments_to_date" class="form-control"
                     placeholder="To Date" autocomplete="off"
                     value="<%= @to_date.strftime('%d-%b-%Y') %>"/>
            </div>
          </div>

          <div class="col-md-2">
            <label style="font-size:12px; color:#777;">Plan</label>
            <select name="filter_plan" id="filter_plan" class="form-select select-height">
              <option value="">All Plans</option>
              <% @all_plans.each do |plan| %>
                <option value="<%= plan.id %>" <%= 'selected' if @filter_plan == plan.id.to_s %>><%= plan.plan_name %></option>
              <% end %>
            </select>
          </div>

          <div class="col-md-2">
            <label style="font-size:12px; color:#777;">Payment Mode</label>
            <select name="filter_mode" id="filter_mode" class="form-select select-height">
              <option value="">All Modes</option>
              <option value="cash"  <%= 'selected' if @filter_mode == 'cash'  %>>Cash</option>
              <option value="upi"   <%= 'selected' if @filter_mode == 'upi'   %>>UPI</option>
              <option value="other" <%= 'selected' if @filter_mode == 'other' %>>Other</option>
            </select>
          </div>

          <div class="col-md-2">
            <label style="font-size:12px; color:#777;">&nbsp;</label><br/>
            <button type="button" onclick="applyFilter();" class="btn btn-circle btn-default">
              <i class="fa fa-search"></i> Filter
            </button>
            <a href="<%= root_url %>trn_payments">
              <button type="button" class="btn btn-circle btn-info"><i class="fa fa-refresh"></i></button>
            </a>
          </div>

        </div>
        <% end %>

      </div>
    </div>
  </div>
</div>

<%# ─── Payments Table ─────────────────────────────────────── %>
<div class="row">
  <div class="col-md-12">
    <div class="card" style="border-radius:6px;">
      <div class="card-body">

        <table class="table table-striped table-bordered table-hover" id="paymentsTable">
          <thead>
            <tr>
              <th>S.No</th>
              <th>Pay No.</th>
              <th>Date</th>
              <th>Member</th>
              <th>Contact</th>
              <th>Plan</th>
              <th>Sub No.</th>
              <th>Sub Period</th>
              <th>MRP</th>
              <th>Discount</th>
              <th>Amount Paid</th>
              <th>Mode</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if @payments.any? %>
              <% @payments.each_with_index do |payment, idx| %>
                <%
                  sub    = @subscriptions_map[payment.pay_ref_id.to_s]
                  member = sub ? @members_map[sub.ms_member_id.to_s]  : nil
                  plan   = sub ? @plans_map[sub.ms_plan_id.to_s]      : nil
                  status = sub ? subscription_status(sub.ms_end_date) : nil
                %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td><strong><%= payment.pay_no %></strong></td>
                  <td><%= formatted_date(payment.pay_date) %></td>
                  <td>
                    <%= member&.mmbr_name || '—' %>
                    <br/><small style="color:#999;"><%= member&.mmbr_code %></small>
                  </td>
                  <td><%= member&.mmbr_contact || '—' %></td>
                  <td>
                    <% if plan %>
                      <span class="badge" style="background:<%= plan_badge_color(plan.plan_name) %>; color:#fff; font-size:11px;">
                        <%= plan.plan_name %>
                      </span>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td><%= sub&.ms_sbscrptn_no || '—' %></td>
                  <td style="font-size:12px;">
                    <% if sub %>
                      <%= formatted_date(sub.ms_start_date) %> →
                      <%= formatted_date(sub.ms_end_date) %>
                    <% end %>
                  </td>
                  <td>₹<%= number_with_delimiter(sub&.ms_plan_amount.to_i) %></td>
                  <td style="color:#e53935;">
                    <% if sub&.ms_discount_amount.to_f > 0 %>
                      -₹<%= number_with_delimiter(sub.ms_discount_amount.to_i) %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td><strong style="color:#26a69a;">₹<%= number_with_delimiter(payment.pay_amount.to_i) %></strong></td>
                  <td>
                    <% mode = payment.pay_mode.to_s.downcase %>
                    <% if mode == 'cash' %>
                      <span class="badge badge-success">Cash</span>
                    <% elsif mode == 'upi' %>
                      <span class="badge" style="background:#ab47bc; color:#fff;">UPI</span>
                    <% elsif mode.blank? %>
                      <span class="badge badge-default">—</span>
                    <% else %>
                      <span class="badge badge-info"><%= payment.pay_mode %></span>
                    <% end %>
                  </td>
                  <td>
                    <% if status == 'ACTIVE' %>
                      <span class="badge badge-success">ACTIVE</span>
                    <% elsif status == 'EXPIRED' %>
                      <span class="badge badge-danger">EXPIRED</span>
                    <% else %>
                      —
                    <% end %>
                  </td>
                </tr>
              <% end %>

              <%# Total row %>
              <tr style="background:#f5f5f5; font-weight:700;">
                <td colspan="10" style="text-align:right; padding-right:20px;">Total Collected</td>
                <td style="color:#26a69a;">₹<%= number_with_delimiter(@total_collected.to_i) %></td>
                <td colspan="2"></td>
              </tr>

            <% else %>
              <tr>
                <td colspan="13" style="text-align:center; padding:30px; color:#aaa;">
                  <i class="fa fa-inbox" style="font-size:30px; display:block; margin-bottom:8px;"></i>
                  No payments found for the selected period.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

      </div>
    </div>
  </div>
</div>

</div>
</div>
</div>
</div>

